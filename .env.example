POSTGRES_PASSWORD=change_me
NUXT_DATABASE_URL=postgresql://urpoint:change_me@127.0.0.1:5432/urpoint
NUXT_PUBLIC_APP_URL=http://localhost:3000
# 32-byte key as 64 hex chars: openssl rand -hex 32
NUXT_LINE_CREDENTIAL_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
NUXT_GOOGLE_CLIENT_ID=
NUXT_GOOGLE_CLIENT_SECRET=

# Local S3-compatible storage (MinIO via docker compose)
MINIO_ROOT_USER=urpoint
MINIO_ROOT_PASSWORD=urpoint_minio_dev
MINIO_BUCKET=urpoint
NUXT_S3_ENDPOINT=http://127.0.0.1:9000
NUXT_S3_REGION=us-east-1
NUXT_S3_ACCESS_KEY_ID=urpoint
NUXT_S3_SECRET_ACCESS_KEY=urpoint_minio_dev
NUXT_S3_BUCKET=urpoint
NUXT_S3_FORCE_PATH_STYLE=true
